// docs/Issues.md §33.6/§33.15: this file is currently DORMANT, not a live
// security boundary. Firebase Storage is absent from firebase.json entirely
// (only "firestore"/"functions"/"hosting" are configured — there is no
// "storage" key, so these rules are never deployed), and the client has no
// `firebase_storage` dependency in pubspec.yaml at all — every avatar/
// ride-photo upload goes through CloudinaryUploadService instead (see its
// doc comment: Firebase Storage requires the Blaze billing plan, which this
// project isn't on). So today, neither the audience-tier gap §33.6
// originally flagged nor the missing size/content-type check §33.15 flagged
// can actually be exploited through this file — there is nothing here to
// exploit until "storage" is added back to firebase.json and this project
// moves to Blaze.
//
// §33.15 is fixed below (a write must now be an actual image under a sane
// size) — that's a self-contained Storage-rules check, safe to harden without
// a live deploy to verify it against.
//
// §33.6 (ride-share photos readable by any authed rider, not gated by the
// ride's own public/followers/mutual audience like the ride doc itself) is
// NOT fixed here. Closing it properly means calling out to Firestore from a
// Storage rule (`firestore.get(/databases/(default)/documents/rides/$(id))`)
// to check the matching ride doc's audience — real syntax, but nothing in
// this repo currently exercises it (no Storage emulator test harness the way
// scripts/test/rules/ covers Firestore), and this file isn't even deployed
// today. Shipping untested cross-service rule syntax for dormant
// infrastructure risks a silent typo sitting unnoticed until the day it
// actually matters. Left as a follow-up for whenever "storage" is added back
// to firebase.json: mirror rideVisibleTo() from firestore.rules via
// firestore.get() on the ride doc named by this path's filename, and add it
// to a real emulator test (firebase emulators:exec --only firestore,storage)
// before trusting it.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Avatars — `avatars/{uid}.jpg`. Public-read (shown on profiles/feed
    // cards to any authed rider), owner-only write. Wildcards match a whole
    // path segment, so `filename` captures `{uid}.jpg` as one string and is
    // compared against the expected name rather than pattern-matched.
    //
    // §33.15: write additionally bounded to an actual image under 5MB — the
    // original rule accepted a write of any size/type to this slot, which
    // (once this file is ever live) would be a storage/bandwidth
    // cost-griefing vector against the project, not against other users.
    match /avatars/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && filename == request.auth.uid + '.jpg' &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Ride-share photos — `rideShares/{uid}/{rideId}.jpg`. Same trust model
    // as the ride doc's own `photoUrl` field: readable by any authed rider
    // (mirrors the public-read `users/{uid}` profile doc rule — a shared
    // photo URL is only ever handed out via a ride doc the reader already
    // passed firestore.rules' rideVisibleTo() to read), owner-only write.
    //
    // Known gap, NOT fixed here — see docs/Issues.md §33.6's note above this
    // match block for why and what closing it properly would take.
    match /rideShares/{uid}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
