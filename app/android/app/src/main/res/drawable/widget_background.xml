<?xml version="1.0" encoding="utf-8"?>
<!--
    Carbon Mono panel: near-black fill, hairline border, 2dp corners.
    Deliberately NOT @android:dimen/system_app_widget_background_radius — the
    design language is sharp-cornered everywhere else in the app and the
    widget should read as the same object, not a rounded system card.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_background" />
    <corners android:radius="2dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_border" />
</shape>
