<?xml version="1.0" encoding="utf-8"?>
<!--
    Carbon Mono palette, mirrored from lib/core/theme/app_theme_style.dart
    (AppColorPalette.carbonMonoDark). These are the home-screen widgets'
    DEFAULTS only: once the app has run, it publishes the active theme's
    colors (HomeWidgetService.publishTheme) and WidgetTheme.kt recolors every
    widget to match. These show for a widget placed before the app ever ran,
    and in the launcher's widget-picker preview.
-->
