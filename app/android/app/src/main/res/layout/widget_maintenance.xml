<?xml version="1.0" encoding="utf-8"?>
<!--
    Maintenance — 4x1. One line that answers "what's next and how far away".
    The left accent bar and the status chip both flip to danger red when the
    service is overdue (swapped from MaintenanceWidgetProvider), so the state
    is readable at a glance without reading the words.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_maintenance_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Panel chrome as two tintable images (border, then fill inset by
         1dp) so WidgetTheme can recolor it with setColorFilter; a
         RemoteViews background drawable cannot be recolored. -->
    <ImageView
        android:id="@+id/widget_bg_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_panel_border"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_bg_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:src="@drawable/widget_panel_fill"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_maintenance_accent"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_accent_bar"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_maintenance_title"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.18"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Status chip: a tintable rounded image behind the label so
                     the provider can recolor it (primary for DUE, danger for
                     overdue) with setColorFilter and keep the 2dp corners. -->
                <FrameLayout
                    android:id="@+id/widget_maintenance_flag_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/widget_maintenance_flag_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/widget_chip_due"
                        android:scaleType="fitXY"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/widget_maintenance_flag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="5dp"
                        android:paddingRight="5dp"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:text="@string/widget_maintenance_due_flag"
                        android:textColor="@color/widget_on_primary"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.10"
                        android:maxLines="1" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_maintenance_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/widget_placeholder_no_service"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_maintenance_bike"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_placeholder_value"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
