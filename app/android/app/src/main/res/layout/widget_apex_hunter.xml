<?xml version="1.0" encoding="utf-8"?>
<!--
    Apex Hunter — 4x2. Displays maximum lean angles for left and right,
    rider lean rating badge, and left-right symmetry percentage.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_apex_hunter_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Panel chrome as two tintable images (border, then fill inset by
         1dp) so WidgetTheme can recolor it with setColorFilter; a
         RemoteViews background drawable cannot be recolored. -->
    <ImageView
        android:id="@+id/widget_bg_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_panel_border"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_bg_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:src="@drawable/widget_panel_fill"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_accent_bar"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_accent_bar"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_apex_title"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.18"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_apex_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_placeholder_no_data"
                    android:textColor="@color/widget_primary"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.10"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_label_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_apex_lean_left"
                        android:textColor="@color/widget_text_tertiary"
                        android:textSize="9sp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.12"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/widget_apex_left_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/widget_placeholder_value"
                        android:textColor="@color/widget_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_label_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_apex_lean_right"
                        android:textColor="@color/widget_text_tertiary"
                        android:textSize="9sp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.12"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/widget_apex_right_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/widget_placeholder_value"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_apex_symmetry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_placeholder_value"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
