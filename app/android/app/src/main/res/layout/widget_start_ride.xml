<?xml version="1.0" encoding="utf-8"?>
<!--
    Start Ride — 2x1. Carbon Mono by default (WidgetTheme recolors it to the
    app theme): near-black panel, hairline border, one solid
    lime action block. Everything is RemoteViews-safe (FrameLayout / LinearLayout /
    TextView / ImageView only).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_start_ride_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/widget_start_ride_content_description">

    <!-- Panel chrome as two tintable images (border, then fill inset by
         1dp) so WidgetTheme can recolor it with setColorFilter; a
         RemoteViews background drawable cannot be recolored. -->
    <ImageView
        android:id="@+id/widget_bg_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_panel_border"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_bg_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:src="@drawable/widget_panel_fill"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_start_ride_title"
            android:textColor="@color/widget_text_secondary"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.18"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:id="@+id/widget_cta_block"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_button_primary">

            <TextView
                android:id="@+id/widget_cta_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_start_ride_cta"
                android:textColor="@color/widget_on_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.10"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
