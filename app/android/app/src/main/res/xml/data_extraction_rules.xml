<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing leaves the phone, by cloud backup or by a maker's
     phone-to-phone transfer. Some makers still run device transfer when
     allowBackup="false", so every domain is excluded here as well. The
     ride database (GPS trails) and preferences are the reason; see the
     comment on <application> in AndroidManifest.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
