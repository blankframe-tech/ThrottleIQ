<?xml version="1.0" encoding="utf-8"?>
<!--
    2x1. Same footprint and refresh policy as start_ride_widget_info.xml — see
    that file for why updatePeriodMillis is 30 min despite the widget being
    stateless.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_auto_tracking"
    android:previewLayout="@layout/widget_auto_tracking"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/widget_auto_tracking_description"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen" />
