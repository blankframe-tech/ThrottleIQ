<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Location permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- No ads/attribution SDK is used; this gets merged in transitively by a
         Firebase/Play-services dependency (Crashlytics/Google Sign-In). Strip
         it so Play Console doesn't force an "app uses advertising ID"
         declaration we can't honestly make. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <!-- Sensors -->
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />

    <!-- Activity recognition: the auto-tracking trigger.

         This is what lets ThrottleIQ notice a ride starting without polling
         GPS. The platform classifier runs at OS-managed power (effectively
         free); GPS is only started once it reports vehicle motion. Polling
         location on a timer instead would cost 5-10% battery per hour and
         make all-day tracking unshippable — see docs/AUTO_TRACKING_PLAN.md.

         ACTIVITY_RECOGNITION is the API 29+ runtime permission; the
         com.google.android.gms one covers API 28 and below. Both are needed
         for the same capability across the range of devices this app targets. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />

    <!-- Voice notes ("Ride with friends" push-to-talk). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Crash alerts must be able to take over a locked screen.

         Without this (Android 14+) a crash notification degrades to an
         ordinary heads-up notification. It is still delivered, but a rider
         whose phone is in a pocket may not see it — and the 60-second
         countdown to contacting their emergency contacts runs either way.
         The whole point of the escalation is that it is answerable without
         opening the app. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service for background GPS -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Lets us ask the rider to whitelist ThrottleIQ from battery
         optimization — several OEMs kill background processes even with an
         active foreground service unless the app is explicitly exempted. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- docs/Issues.md §24.9: this app's local SQLite DB holds every rider's
         GPS trail, unencrypted. android:allowBackup defaults to true, which
         makes that database eligible both for Android's automatic cloud
         backup (Google Drive, on eligible devices) and for `adb backup`
         extraction from anyone with physical/debug access to the device.
         Disabling it outright closes both paths at once; there's no
         supported fine-grained exclusion (dataExtractionRules/
         fullBackupContent) needed on top of that once backup itself is off. -->
    <application
        android:label="ThrottleIQ"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        tools:replace="android:label">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Background GPS during a ride is handled by geolocator's own
             foreground service, configured from Dart via
             ForegroundNotificationConfig (ride_recording_provider.dart). A
             `com.bft.throttleiq.LocationForegroundService` used to be declared
             here, but that class never existed anywhere in the repo — nothing
             started it, so it was dead config, removed per docs/Issues.md §27
             (declaring a location-type service the app doesn't implement is
             the kind of mismatch that draws a rejection in Google's
             Background Location Access review). -->

        <!-- flutter_foreground_task's service: the free-tier auto-tracking
             detector (auto_tracking_service.dart), replacing the paid
             flutter_background_geolocation plugin as of 2026-08-28 — see
             that file's doc comment and
             docs/archives/flutter_background_geolocation-2026-08-28/. Unlike
             the plugin this replaces, this one does NOT merge its own
             service declaration in automatically; it must be declared here,
             with the exact name below (per the library's own install
             instructions — do not rename). foregroundServiceType="location"
             matches what this service actually does (watches for motion,
             then GPS), keeping the Background Location Access review honest
             — the same reasoning that removed the dead declaration above. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- Firebase Messaging -->
        <service
            android:name="com.google.firebase.messaging.FirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Home-screen App Widgets.
             Must be exported: the launcher process sends APPWIDGET_UPDATE
             broadcasts to them from outside the app. Data comes from the
             home_widget plugin's SharedPreferences, written by
             lib/core/services/home_widget_service.dart. -->
        <receiver
            android:name=".StartRideWidgetProvider"
            android:exported="true"
            android:label="@string/widget_start_ride_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/start_ride_widget_info" />
        </receiver>

        <receiver
            android:name=".RideStatsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_ride_stats_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ride_stats_widget_info" />
        </receiver>

        <receiver
            android:name=".MaintenanceWidgetProvider"
            android:exported="true"
            android:label="@string/widget_maintenance_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/maintenance_widget_info" />
        </receiver>

        <receiver
            android:name=".AutoTrackingWidgetProvider"
            android:exported="true"
            android:label="@string/widget_auto_tracking_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/auto_tracking_widget_info" />
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Required by url_launcher on Android 11+ (API 30), which introduced
             package visibility: without a matching <intent> here the launcher
             cannot see *any* app that handles these, so a place's "Directions"
             and "Call" buttons would fail with an ActivityNotFoundException on
             a modern phone while working fine on an old one. Declaring the
             intents (rather than specific package names) keeps this working
             whatever maps app or dialler the rider actually uses. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
