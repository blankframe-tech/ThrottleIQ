<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	    Shared with ThrottleIQWidget/ThrottleIQWidget.entitlements — this is the
	    only channel between the app and the widget extension. Must match
	    HomeWidgetService.appGroupId in Dart and exist on the Apple Developer
	    portal for both bundle IDs, or UserDefaults(suiteName:) returns nil on
	    one side and every widget renders its placeholder forever.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.bft.throttleiq</string>
	</array>
	<!--
	    Universal Links (com.apple.developer.associated-domains for
	    applinks:blankframe.tech etc.) are deliberately NOT enabled: team
	    NJ4675FFUX is a personal development team, which Apple does not allow
	    to use Associated Domains, and the entitlement breaks signing. iOS
	    follow links go through the web fallback (public/follow.html) and the
	    throttleiq://u/<uid> custom scheme instead. Re-add once on a paid team.
	-->
</dict>
</plist>
