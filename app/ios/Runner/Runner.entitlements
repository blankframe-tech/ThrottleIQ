<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	    Shared with ThrottleIQWidget/ThrottleIQWidget.entitlements — this is the
	    only channel between the app and the widget extension. Must match
	    HomeWidgetService.appGroupId in Dart and exist on the Apple Developer
	    portal for both bundle IDs, or UserDefaults(suiteName:) returns nil on
	    one side and every widget renders its placeholder forever.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.bft.throttleiq</string>
	</array>
	<!--
	    Universal Links for follow links (https://blankframe.tech/ThrottleIQ/u/<uid>).
	    Each host must serve /.well-known/apple-app-site-association
	    (public/well-known/apple-app-site-association) naming
	    NJ4675FFUX.com.bft.throttleiq, and the App ID needs the Associated
	    Domains capability enabled on the Apple Developer portal.
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:blankframe.tech</string>
		<string>applinks:www.blankframe.tech</string>
		<string>applinks:throttleiqfb.web.app</string>
	</array>
</dict>
</plist>
