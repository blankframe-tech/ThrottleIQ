{
  "name": "throttleiq-scripts",
  "version": "1.0.0",
  "private": true,
  "description": "Operational scripts for the ThrottleIQ Firebase project (throttleiqfb). Not part of the Flutter app or the Cloud Functions deploy.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "cleanup:qa-engagement:dry-run": "node oneoff/cleanup_qa_engagement.js",
    "cleanup:qa-engagement:execute": "node oneoff/cleanup_qa_engagement.js --yes-i-really-mean-it",
    "reset:dry-run": "node oneoff/reset_beta_data.js --dry-run",
    "reset:execute": "node oneoff/reset_beta_data.js --yes-i-really-mean-it",
    "seed:dhaka:fetch": "node oneoff/seed_dhaka_places.js --out=dhaka_places.json",
    "seed:dhaka:dry-run": "node oneoff/seed_dhaka_places.js --dry-run",
    "seed:dhaka:execute": "node oneoff/seed_dhaka_places.js --yes-i-really-mean-it",
    "seed:qa-riders:dry-run": "node oneoff/seed_qa_test_riders.js --dry-run",
    "seed:qa-riders:execute": "node oneoff/seed_qa_test_riders.js --yes-i-really-mean-it",
    "seed:qa-riders:cleanup:dry-run": "node oneoff/cleanup_qa_test_riders.js --dry-run",
    "seed:ai-cameras:dry-run": "node oneoff/seed_ai_cameras.js --dry-run",
    "seed:ai-cameras:execute": "node oneoff/seed_ai_cameras.js --yes-i-really-mean-it",
    "seed:checkposts:dry-run": "node oneoff/seed_police_checkposts.js --dry-run",
    "seed:checkposts:execute": "node oneoff/seed_police_checkposts.js --yes-i-really-mean-it",
    "seed:checkposts-v2:dry-run": "node oneoff/seed_police_checkposts_v2.js --dry-run",
    "seed:checkposts-v2:execute": "node oneoff/seed_police_checkposts_v2.js --yes-i-really-mean-it",
    "seed:checkposts-v3:dry-run": "node oneoff/seed_police_checkposts_v3.js --dry-run",
    "seed:checkposts-v3:execute": "node oneoff/seed_police_checkposts_v3.js --yes-i-really-mean-it",
    "import:google-places:dry-run": "node oneoff/import_google_places.js",
    "revert:google-places:dry-run": "node oneoff/revert_google_places.js --seeded-only",
    "test": "node --test \"test/*.test.js\"",
    "test:rules": "JAVA_HOME=\"${JAVA_HOME:-/opt/homebrew/opt/openjdk@21}\" firebase emulators:exec --project=demo-throttleiq --only firestore \"'$npm_node_execpath' --test test/rules/*.test.js\"",
    "test:rules:ci": "firebase emulators:exec --project=demo-throttleiq --only firestore \"'$npm_node_execpath' --test test/rules/*.test.js\"",
    "test:rtdb": "JAVA_HOME=\"/opt/homebrew/opt/openjdk@21\" firebase emulators:exec --project=demo-throttleiq --only database \"'$npm_node_execpath' --test test/rtdb/*.test.js test/live_viewer_core.test.js\"",
    "test:rtdb:ci": "firebase emulators:exec --project=demo-throttleiq --only database \"'$npm_node_execpath' --test test/rtdb/*.test.js test/live_viewer_core.test.js\"",
    "loadtest:rehearsal": "node loadtest/quota_rehearsal.js",
    "loadtest:quota": "JAVA_HOME=\"/opt/homebrew/opt/openjdk@21\" firebase emulators:exec --project=throttleiq-loadtest --only firestore \"'$npm_node_execpath' loadtest/quota_sim.js\"",
    "check": "node --check oneoff/reset_beta_data.js && node --check oneoff/seed_dhaka_places.js && node --check oneoff/seed_qa_test_riders.js && node --check oneoff/cleanup_qa_test_riders.js && node --check oneoff/cleanup_qa_engagement.js && node --check oneoff/qa_seed_catalog.js && node --check oneoff/seed_ai_cameras.js && node --check oneoff/seed_police_checkposts.js && node --check oneoff/seed_police_checkposts_v2.js && node --check oneoff/seed_police_checkposts_v3.js && node --check oneoff/import_google_places.js && node --check oneoff/revert_google_places.js && node --check oneoff/migrate_emails_private.js && node --check oneoff/backfill_users_visibility.js && node --check oneoff/backfill_vote_uid.js && node --check loadtest/quota_rehearsal.js"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1"
  }
}
