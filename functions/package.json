{
  "name": "throttleiq-functions",
  "description": "Cloud Functions for ThrottleIQ crash detection and notifications",
  "version": "1.0.0",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"test/*.test.js\"",
    "test:emulator": "tsc && firebase emulators:exec --project=demo-throttleiq --only firestore,database \"'$npm_node_execpath' --test --test-concurrency=1 test/emulator/*.test.js\"",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
