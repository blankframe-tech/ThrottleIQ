rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Whether the requester may see a shared-ride document, given its data.
    // Used by the ride read rule, the like/comment counter-bump rule, and the
    // likes/comments subcollection reads so the three stay in lockstep.
    // Public → anyone authed; followers/mutual → only uids materialized into
    // allowedUserIds at share time; always the author.
    function rideVisibleTo(ride) {
      return request.auth != null && (
        request.auth.uid == ride.userId ||
        ride.audience == 'public' ||
        (ride.audience in ['followers', 'mutual'] &&
          request.auth.uid in ride.allowedUserIds));
    }

    // Whether the requester may read a users/{uid} profile doc, given its
    // data. 'public' (the default — including legacy docs written before
    // `visibility` existed, so this never regresses pre-existing behavior)
    // is open to any signed-in rider, same as before this function existed.
    // 'mutual' additionally requires both follow edges to exist (I follow
    // them AND they follow me) — a single-doc exists() check works here,
    // unlike rideVisibleTo's allowedUserIds-materialization trick, because a
    // profile view is always a single-doc get, never a list query. 'private'
    // (or anything else) falls through to owner-only.
    function profileVisibleTo(uid, profile) {
      return request.auth != null && (
        request.auth.uid == uid ||
        !('visibility' in profile) || profile.visibility == 'public' ||
        (profile.visibility == 'mutual' &&
          exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + uid)) &&
          exists(/databases/$(database)/documents/follows/$(uid + '_' + request.auth.uid))));
    }

    // Whether the requester may read uid's bikes subcollection. Mirrors
    // canSeeBikes() in app/lib/features/profile/domain/bike_visibility.dart —
    // keep the two in lockstep; the client-side one only hides UI.
    //
    // The middle tier deliberately differs from profileVisibleTo's: a
    // profile's is 'mutual' (both follow edges), a garage's is 'followers'
    // (only requester -> uid), because "hide my bikes from my followers" is
    // about who follows ME. Any unrecognized value — including the absent
    // field on every account created before this shipped — reads as
    // 'public', so this never regresses existing behaviour.
    //
    // Also requires profileVisibleTo: a rider whose profile you may not read
    // shouldn't have a readable garage either.
    //
    // Costs one get() of the owner's profile per bike document read.
    // Acceptable for an on-demand profile view of a handful of bikes; if it
    // ever gets hot, denormalize bikesVisibility onto each bike doc at sync
    // time and read it from resource.data instead.
    function bikesVisibleTo(uid) {
      let profile = get(/databases/$(database)/documents/users/$(uid)).data;
      let tier = profile.get('bikesVisibility', 'public');
      return request.auth != null && (
        request.auth.uid == uid ||
        (profileVisibleTo(uid, profile) && (
          (tier != 'followers' && tier != 'private') ||
          (tier == 'followers' &&
            exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + uid))))));
    }

    // The single global admin. Mirrors kAdminEmail in the app's
    // forum_permissions.dart, but is enforced HERE independently — the client
    // check is only cosmetic (it hides buttons); this is what actually stops
    // a non-admin from deleting other riders' content.
    //
    // docs/Issues.md §24.9: prefers the `admin` custom claim
    // (request.auth.token.admin) — set via scripts/set_admin_claim.js, which
    // only this project's own service-account credentials can run — over the
    // email-string comparison this used to be exclusively. A custom claim can
    // only ever be written server-side with the Admin SDK, never by a client
    // regardless of what a Firestore rule or Cloud Function bug might
    // otherwise allow; an email claim is only as trustworthy as the auth
    // provider's verification of it. The email check remains as a fallback so
    // nothing breaks before set_admin_claim.js has actually been run once —
    // it can be deleted after that.
    // Note the `.get(key, default)` form on email_verified/email, not direct
    // property access: a token that simply lacks the claim (any non-email
    // sign-in method — anonymous, phone) makes `request.auth.token.email_verified`
    // an evaluation ERROR, not `false`. That error propagates out of every
    // rule that calls this, including through the `||` chains in
    // canModerateForum() and the clauses that use it, denying writes that
    // should have been allowed on their other branch. Caught by the rules
    // tests in scripts/test/rules/ (docs/Issues.md §24.11).
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.get('admin', false) == true ||
        (request.auth.token.get('email_verified', false) == true &&
         request.auth.token.get('email', '').lower() == 'the.abraar.rar@gmail.com'));
    }

    // Ties an engagement-counter bump to the SAME transaction
    // creating/deleting the per-user doc it's supposed to represent —
    // docs/Issues.md §24.7. Before this, a tally like `likes` or
    // `upvotes`/`downvotes` could move by exactly ±1 per REQUEST, but
    // nothing capped the number of requests: a client could loop the same
    // update and drive any tally to an arbitrary value, since the rule never
    // looked at the votes/likes subcollection at all. Every real caller
    // (RideShareRepository.toggleLike/.vote, ForumRepository.votePost)
    // already writes the counter bump and the per-user doc in the SAME
    // Firestore transaction, so `existsAfter()`/`getAfter()` — which see the
    // state once the WHOLE transaction commits, unlike `exists()`/`get()`,
    // which see only the state as of the transaction's START — can require
    // that a counter only moves when its paired doc is actually being
    // created, deleted, or flipped in lockstep within that same commit. A
    // client that tries to bump a counter alone, without the paired write,
    // now fails this check; so does looping the same bump repeatedly, since
    // after the first successful call the "before" state has already
    // changed.
    //
    // `likeBumpValid` covers the simple create/delete-only shape (rides'
    // `likes`, a boolean-ish per-user doc). `voteBumpValid` covers the
    // three-state shape (`votes/{uid}` → {value: 1 | -1} or absent) shared by
    // rides' upvotes/downvotes and forum posts' upvotes/downvotes: it reads
    // the vote doc's value before and after (0 standing for "no vote"), and
    // requires the actual upvotes/downvotes diff to match exactly what that
    // before→after transition implies — covering a fresh vote, a toggle-off,
    // and a flip (down→up or up→down) as the same one formula rather than
    // three separate cases.
    function likeBumpValid(likeDocPath, delta) {
      return delta == 1
        ? (!exists(likeDocPath) && existsAfter(likeDocPath))
        : (delta == -1 && exists(likeDocPath) && !existsAfter(likeDocPath));
    }

    // Whether `docPath` is being created by `uid` in THIS commit — the shape
    // behind the comment/reply counter bumps. Unlike likes/votes, whose doc id
    // is the caller's uid and so can be reconstructed inside the rule, a
    // comment/reply gets an auto-generated id the rule has no way to guess, so
    // the bump carries it in `lastCommentId`/`lastReplyId` and this checks that
    // id. `!exists(...)` is what stops a replay: exists() sees the state as of
    // the transaction's START, so pointing the bump at a comment that was
    // already there (anyone's, including the caller's own earlier one) fails.
    // The authorship check keeps the bump from riding on someone else's
    // concurrently-created comment.
    function newDocBy(docPath, uid) {
      return !exists(docPath) && existsAfter(docPath) &&
        getAfter(docPath).data.userId == uid;
    }

    // The mirror of newDocBy for a counter going DOWN: the named doc existed
    // at the start of this commit and is gone after it. No authorship check
    // here on purpose — the doc's own `allow delete` rule decides who may
    // remove it, and it runs in the same batch, so a caller who isn't allowed
    // to delete never gets the decrement either.
    function docRemoved(docPath) {
      return exists(docPath) && !existsAfter(docPath);
    }

    function voteBumpValid(voteDocPath, upvotesBefore, upvotesAfter, downvotesBefore, downvotesAfter) {
      let before = exists(voteDocPath) ? get(voteDocPath).data.value : 0;
      let after = existsAfter(voteDocPath) ? getAfter(voteDocPath).data.value : 0;
      return before != after &&
        (upvotesAfter - upvotesBefore) == (after == 1 ? 1 : 0) - (before == 1 ? 1 : 0) &&
        (downvotesAfter - downvotesBefore) == (after == -1 ? 1 : 0) - (before == -1 ? 1 : 0);
    }

    // Whether `handle` is claimed by `uid` in usernames/{handle}, evaluated
    // AFTER the current write (existsAfter/getAfter, not exists/get) — used
    // to validate a users/{uid} profile write's usernameLower field below.
    // This has to be the "After" form: setUsername() claims the handle and
    // writes the profile doc's usernameLower in the SAME transaction, and a
    // plain exists()/get() inside a rule sees only the state as of the
    // transaction's START, before either write lands — it would see no
    // usernames/{handle} doc yet and reject every legitimate username claim.
    // existsAfter()/getAfter() see the state once the whole transaction has
    // committed, which is exactly what's needed to check two documents
    // written together for consistency. (rules_version '2', declared at the
    // top of this file, is required for these to exist at all.)
    function usernameClaimedBy(handle, uid) {
      return existsAfter(/databases/$(database)/documents/usernames/$(handle)) &&
        getAfter(/databases/$(database)/documents/usernames/$(handle)).data.uid == uid;
    }

    // Whether the requester may moderate (delete other people's content in)
    // the given forum. Costs one document read per evaluation — acceptable
    // because it only fires on a delete, never on the read/list hot path.
    // Auto-created bike/topic forums carry neither field, so this correctly
    // reduces to admin-only for them.
    function canModerateForum(forumId) {
      return isAdmin() || (request.auth != null &&
        exists(/databases/$(database)/documents/forums/$(forumId)) &&
        (get(/databases/$(database)/documents/forums/$(forumId)).data.get('createdBy', '') == request.auth.uid ||
         request.auth.uid in get(/databases/$(database)/documents/forums/$(forumId)).data.get('maintainerIds', [])));
    }

    // User profiles.
    //
    // The root profile DOCUMENT is now readable by any authenticated user —
    // riders are found by @username prefix / exact email and followed, which
    // requires cross-user profile reads (see ProfileRepository.searchBy*). The
    // root doc holds only public-facing fields (displayName, username,
    // nickname, bio, photoUrl, email — email exposure is intentional, the user
    // explicitly wants find-by-email). Writes stay owner-only, and every
    // subcollection below (rides/bikes/maintenance/emergencyContacts/...)
    // keeps its own owner-only rule, so opening the root doc does not expose
    // any of them.
    //
    // Gated by profileVisibleTo since a rider can now set `visibility` to
    // 'mutual' or 'private' (see EditProfileScreen) — defaults to the
    // pre-existing fully-open behavior for anyone who never touches it.
    match /users/{uid} {
      allow read: if profileVisibleTo(uid, resource.data);

      // Owner-only, PLUS docs/Issues.md §24.5: a usernameLower change must be
      // backed by a real claim in usernames/{handle}. This rule used to be a
      // bare `request.auth.uid == uid` with no field validation at all.
      // ProfileRepository.setUsername() claims usernames/{handle} in a
      // transaction to guarantee global handle uniqueness, but nothing
      // stopped a client from skipping that transaction and writing
      // {'usernameLower': 'victimhandle', ...} straight into its own profile
      // doc — rider search (searchByUsername) reads usernameLower directly,
      // not the reservation collection, so that alone was enough to
      // impersonate any handle in search results.
      //
      // "Changed" means the merged resulting document's usernameLower
      // differs from what's currently stored — the very common case of some
      // OTHER field being written (updatePublicStats, setVisibility, a
      // `set(..., merge: true)` that doesn't touch usernameLower at all)
      // still carries usernameLower in request.resource.data because merge
      // writes are evaluated against the full resulting document, not just
      // the sent fields — so this only actually constrains a write that
      // introduces a NEW usernameLower value.
      allow write: if request.auth.uid == uid &&
        (!('usernameLower' in request.resource.data) ||
         (resource != null &&
          resource.data.get('usernameLower', null) == request.resource.data.usernameLower) ||
         usernameClaimedBy(request.resource.data.usernameLower, request.auth.uid));

      // User rides subcollection
      match /rides/{rideId} {
        allow read, write: if request.auth.uid == uid;

        // The ride's GPS trail, stored as chunked documents rather than one
        // doc per point (see ride_track_codec.dart). Owner-only, exactly like
        // the parent ride — a raw track is the most location-sensitive data
        // the app holds, and sharing a ride publishes a privacy-clipped copy
        // onto the shared_rides doc instead of exposing this.
        match /track/{chunkId} {
          allow read, write: if request.auth.uid == uid;
        }
      }

      // User bikes subcollection. Reads are gated by the rider's own
      // bikesVisibility setting (see bikesVisibleTo); writes stay owner-only
      // so nobody can touch someone else's garage.
      match /bikes/{bikeId} {
        allow read: if bikesVisibleTo(uid);
        allow write: if request.auth.uid == uid;
      }

      // User maintenance logs subcollection
      match /maintenance/{maintenanceId} {
        allow read, write: if request.auth.uid == uid;
      }

      // Emergency contacts subcollection
      match /emergencyContacts/{contactId} {
        allow read, write: if request.auth.uid == uid;
      }

      // Saved routes. Unlike the owner-only subcollections around it, a route
      // marked public is readable by any signed-in rider — that's the whole
      // point of the Discover tab. Writes stay owner-only, so nobody can
      // publish, rename, or delete someone else's route.
      //
      // This match handles single-doc gets and the owner's own list query;
      // the collectionGroup('routes') query behind getPublicRoutes needs the
      // separate rule below, because a collection-group query is not matched
      // by a path-anchored rule.
      match /routes/{routeId} {
        allow read: if request.auth.uid == uid ||
          (request.auth != null && resource.data.get('isPublic', false) == true);
        allow write: if request.auth.uid == uid;
      }

      // False crash positives (for tuning/analytics)
      match /falseCrashPositives/{documentId} {
        allow write: if request.auth.uid == uid;
        allow read: if request.auth.uid == uid;
      }

      // Rider Stats milestone badges (Epic F). Earned/not-earned is always
      // recomputed client-side from local ride data
      // (core/utils/badges.dart) — this collection is just a durable
      // per-user record of what's been earned, owner-only like the other
      // subcollections above, laying the groundwork for a future
      // partner-discount lookup.
      match /earnedBadges/{badgeId} {
        allow read, write: if request.auth.uid == uid;
      }

      // In-app notifications (e.g. "so-and-so followed you") — the one
      // subcollection here that ISN'T owner-only to write, by necessity:
      // the write always happens from the *other* rider's device (following
      // someone writes a notification into the followee's subcollection).
      // Bounded so a rider can only ever write a notification claiming to
      // be from themselves, never spoof another uid as the source. Reads/
      // updates (marking read)/deletes stay owner-only.
      // docs/Issues.md §33.4: `fromUid == request.auth.uid` alone bounded WHO
      // a notification could claim to be from, but nothing bounded the
      // `{uid}` it landed in (any signed-in rider could target any victim)
      // or the free-text content — `fromName`/`fromPhotoUrl`/`type` were
      // entirely unvalidated. Concretely: any signed-in rider could flood an
      // arbitrary victim's feed with a spoofed sender name, or set
      // `fromPhotoUrl` to an attacker-controlled URL that the victim's
      // device fetches unconditionally the moment they open Notifications —
      // an unauthenticated tracking beacon with no relationship to the
      // victim required at all.
      //
      // `type` is now restricted to the two kinds the app actually writes
      // (NotificationType in app_notification_entity.dart), and
      // `fromPhotoUrl` — the concrete tracking-pixel vector — must be null/
      // absent/empty or a URL on a domain this app actually serves avatars
      // from (Cloudinary under this project's own cloud name, or Google's
      // account-picture host for Google sign-in). `fromName` is left
      // otherwise free-text: matching it against the sender's real profile
      // would mean replicating UserProfileEntity.bestName's nickname →
      // displayName → @username fallback chain inside a rule, which is
      // fragile to keep in lockstep and risks silently breaking legitimate
      // follow/invite notifications if it ever drifts from the client. A
      // spoofed display NAME (not a URL fetched automatically) is a lower-
      // severity, residual risk closer to any other free-text social content
      // this app already carries (captions, forum posts) — not the
      // unconditional device-fetch/beacon vector this fix closes.
      match /notifications/{notificationId} {
        allow read, update, delete: if request.auth.uid == uid;
        allow create: if request.auth != null &&
          request.resource.data.fromUid == request.auth.uid &&
          request.resource.data.get('type', '') in ['follow', 'groupRideInvite'] &&
          request.resource.data.get('fromName', '') is string &&
          request.resource.data.get('fromName', '').size() > 0 &&
          request.resource.data.get('fromName', '').size() <= 100 &&
          (!('fromPhotoUrl' in request.resource.data) ||
           request.resource.data.fromPhotoUrl == null ||
           request.resource.data.fromPhotoUrl == '' ||
           (request.resource.data.fromPhotoUrl is string &&
            request.resource.data.fromPhotoUrl.matches(
              '^https://(res\\.cloudinary\\.com/vjvcigkt/|lh3\\.googleusercontent\\.com/).*'))) &&
          (request.resource.data.get('type', '') != 'groupRideInvite' ||
           (request.resource.data.get('groupRideId', '') is string &&
            request.resource.data.get('groupRideId', '') != ''));
      }
    }

    // Live sessions - readable by anyone with token (capability-based access)
    // Writable only by ride owner
    match /liveSessions/{token} {
      // Anyone holding the token can read that ONE session, without signing
      // in — that's the whole point of a shareable live link.
      //
      // `get`, deliberately NOT `read`. In Firestore `read` = `get` + `list`,
      // so the previous `allow read: if true` let any client — unauthenticated
      // — enumerate the entire liveSessions collection and pull every rider's
      // live GPS position without knowing a single token. The 32-character
      // token was no protection at all against a collection listing. Granting
      // only `get` means a caller must already know the exact doc id, which
      // restores the intended "the link is the permission" model.
      //
      // Every caller does a keyed .doc(token) lookup (public/live-viewer.html
      // and ride_recording_provider.dart), so nothing legitimately lists this
      // collection and dropping `list` breaks no existing flow.
      //
      // `shareable == true` is required IN ADDITION to knowing the token —
      // docs/Issues.md §24.1. The premise this rule used to rely on ("a rider
      // only appears here because they published a shareable live session in
      // the first place") was false: the client called
      // `_startLiveSessionPublishing()` unconditionally from `startRide()`,
      // so every ride minted a readable session whether or not the rider
      // ever meant to share it. The client fix (ride_recording_provider.dart
      // `enableLiveSharing()`) now gates publishing behind an explicit opt-in
      // and stamps `shareable: true` only on docs written after that opt-in
      // — but a rules-only check is what actually stops a stranger, since
      // client-side gating alone leaves every already-written session (and
      // any future client regression) readable. `.get('shareable', false)`
      // means any legacy doc written before this field existed reads as
      // NOT shareable — fail closed, not open.
      //
      // docs/Issues.md §33.2: ALSO requires `expiresAt` to be in the future.
      // The client (public/live-viewer.html) enforced the 24h TTL only in
      // its own JS — nothing stopped a caller from skipping the page
      // entirely and reading the doc straight off the Firestore REST API
      // with a token from a link that had "expired" hours or days earlier.
      // Same fail-closed default as `shareable`: `.get('expiresAt',
      // request.time)` means a doc with no `expiresAt` at all compares as
      // `request.time > request.time`, i.e. false — denied, not left open.
      allow get: if resource.data.get('shareable', false) == true &&
        resource.data.get('expiresAt', request.time) > request.time;

      // Only the ride owner (uid) can write
      allow create: if request.auth.uid == request.resource.data.uid;
      allow update: if request.auth.uid == resource.data.uid;
    }

    // Crash notifications - the client only ever CREATEs one (see
    // ride_recording_provider.dart's crash-detection path, which `.add()`s a
    // single `status: 'pending'` doc and never updates it again). Every
    // status transition after that ('contacted', 'escalated', ...) is done
    // server-side by functions/src/crash-notifications.ts via the Admin SDK,
    // which is not subject to these rules at all — so the client never
    // legitimately needs update/delete here.
    //
    // docs/Issues.md §33.18: this used to be a bare `allow write`, which also
    // covers update — a rider could freely rewrite their own doc's `status`
    // after creation (e.g. straight to 'acknowledged'), which could suppress
    // the escalation this collection exists to drive once real delivery
    // ships (currently mocked — Cloud Functions can't deploy on this
    // project's billing plan, docs/Issues.md §24). Scoping to `create` only,
    // with the shape the client actually writes, closes that off; no
    // `allow update`/`allow delete` is granted at all.
    match /crashNotifications/{documentId} {
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid &&
        request.resource.data.get('status', '') == 'pending';
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Shared/public rides (Social feed) — top-level collection.
    //
    // Visibility is governed by an `audience` field ∈ {public, followers,
    // mutual}. Because Firestore rules are NOT query filters — a list query
    // whose rule needs a per-doc exists()/get() lookup is rejected wholesale —
    // followers/mutual visibility is materialized at SHARE time into the
    // `allowedUserIds` array (the author's follower/mutual uids), and the feed
    // reads it with `where('allowedUserIds', arrayContains: myUid)`. Each of
    // the three real feed queries lines up with exactly one clause below
    // (audience=='public' | allowedUserIds array-contains me | userId==me), so
    // every query is satisfiable without a rule-side document lookup.
    match /rides/{rideId} {
      // `resource` is null when the doc doesn't exist yet — dereferencing
      // resource.data in that case throws, which the rules engine treats as
      // a denied read (surfaced to the client as permission-denied, not
      // exists:false). RideShareRepository.shareRide() does exactly that
      // read (an existence check before its first-time create), so every
      // brand-new share hit permission-denied before the write was ever
      // attempted. Guard it explicitly: a nonexistent doc has no data to
      // protect, so it's always safe to let the read through.
      allow read: if resource == null || rideVisibleTo(resource.data);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Owner can update/delete the ride freely, but may not reassign
      // authorship (userId is immutable on this branch).
      allow update: if request.auth != null && resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId;
      // Any authenticated user who can see the ride may bump the engagement
      // counters, but cannot touch any other field or set an arbitrary value.
      // Three disjoint shapes:
      //   - likes: ±1 (legacy heart; kept for back-compat), tied to the
      //     caller's own likes/{uid} doc being created/deleted in the same
      //     transaction (docs/Issues.md §24.7 — see likeBumpValid above).
      //   - comments: +1, now tied to the comment doc named by the bump's own
      //     `lastCommentId` being created by the caller in the same
      //     transaction (docs/Issues.md §24.7 — see newDocBy above).
      //     addComment() was made transactional to close this; a client that
      //     loops the bump with no comment posted, or that points it at a
      //     comment that already existed, now fails.
      //   - upvotes/downvotes: tied to the caller's own votes/{uid} doc's
      //     value (before/after this transaction) via voteBumpValid — covers
      //     a fresh vote, a toggle-off, and a flip (down→up or up→down,
      //     which moves both tallies in one write) as a single formula. The
      //     net score is derived client-side (upvotes - downvotes); it is
      //     deliberately not stored, so there is no orderable score field to
      //     spoof.
      allow update: if request.auth != null && rideVisibleTo(resource.data) &&
        ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
          likeBumpValid(
            /databases/$(database)/documents/rides/$(rideId)/likes/$(request.auth.uid),
            request.resource.data.likes - resource.data.likes)) ||
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'lastCommentId']) &&
          request.resource.data.comments == resource.data.comments + 1 &&
          request.resource.data.get('lastCommentId', '') is string &&
          request.resource.data.get('lastCommentId', '') != '' &&
          newDocBy(
            /databases/$(database)/documents/rides/$(rideId)/comments/$(request.resource.data.lastCommentId),
            request.auth.uid)) ||
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'downvotes']) &&
          voteBumpValid(
            /databases/$(database)/documents/rides/$(rideId)/votes/$(request.auth.uid),
            resource.data.upvotes, request.resource.data.upvotes,
            resource.data.downvotes, request.resource.data.downvotes)));
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      match /likes/{userId} {
        allow read: if rideVisibleTo(get(/databases/$(database)/documents/rides/$(rideId)).data);
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      // One vote doc per user: { value: 1 | -1 }.
      match /votes/{userId} {
        allow read: if rideVisibleTo(get(/databases/$(database)/documents/rides/$(rideId)).data);
        allow write: if request.auth != null && request.auth.uid == userId &&
          (request.method == 'delete' ||
           request.resource.data.value == 1 || request.resource.data.value == -1);
      }
      match /comments/{commentId} {
        allow read: if rideVisibleTo(get(/databases/$(database)/documents/rides/$(rideId)).data);
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      }
    }

    // Collection-group read for the Discover tab's
    // collectionGroup('routes').where('isPublic', == true) query.
    //
    // A path-anchored rule (users/{uid}/routes/{id} above) does NOT apply to
    // a collection-group query, so this is required in addition to it, not
    // instead of it. Written as a bare `isPublic == true` rather than
    // `.get('isPublic', false)` because Firestore must be able to prove the
    // query's own filter satisfies the rule, and it can only do that against
    // a direct field comparison matching the filter.
    match /{path=**}/routes/{routeId} {
      allow read: if request.auth != null && resource.data.isPublic == true;
    }

    // Bike forums (Phase 3 — per-brand and per-model discussion boards).
    match /forums/{forumId} {
      allow read: if request.auth != null;
      // getOrCreateForum() only ever calls set() on a forum doc's *first*
      // creation (it re-reads and no-ops if the doc already exists — see
      // ForumRepository.getOrCreateForum) — the app never edits a forum's
      // brand/model/displayName/type after creation. So the only two writes
      // that ever hit an *existing* forums/{forumId} doc are the
      // followerCount and postCount counter bumps below, and those get their
      // own narrowly-scoped ±1-delta rule (mirroring the rides/{rideId}
      // likes/comments counter rule above) rather than being covered by a
      // broad "any authenticated user can update" rule — that would let an
      // attacker set an arbitrary counter value directly instead of only
      // ever incrementing/decrementing by exactly one.
      // Every forum — not just rider-created ('custom') ones — must stamp its
      // creator as the caller and seed the maintainer list with exactly that
      // same uid, or omit both fields entirely. docs/Issues.md §24.4: this
      // constraint used to apply ONLY when type == 'custom', so for any other
      // type (e.g. 'bikeModel') createdBy/maintainerIds were unconstrained.
      // Forum ids are deterministic slugs (bikeForumSlug/generalForumSlug),
      // so an attacker could pre-create a not-yet-existing brand/model forum
      // with maintainerIds: [attackerUid] and hold permanent moderator/delete
      // rights over it forever — canModerateForum() reads exactly those
      // fields. getOrCreateForum() auto-creates bike/topic forums with
      // neither field set at all (see canModerateForum's doc comment above),
      // so "omit both fields" has to stay legal or that flow breaks; what's
      // now closed is a client setting them to anything OTHER than its own
      // uid / a single-element list of its own uid.
      allow create: if request.auth != null &&
        request.resource.data.followerCount == 0 &&
        request.resource.data.postCount == 0 &&
        (!('createdBy' in request.resource.data) || request.resource.data.createdBy == request.auth.uid) &&
        (!('maintainerIds' in request.resource.data) || request.resource.data.maintainerIds == [request.auth.uid]);
      allow update: if request.auth != null &&
        // followerCount moves by exactly ±1 via followForum/unfollowForum
        // (gated separately by the forum_follows/{followId} write rule
        // below, so this only fires alongside a legitimate follow doc
        // create/delete)...
        ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount']) &&
          (request.resource.data.followerCount == resource.data.followerCount + 1 ||
           request.resource.data.followerCount == resource.data.followerCount - 1)) ||
         // ...or postCount moves by exactly ±1: +1 via createPost, -1 via a
         // moderator's deletePost. The -1 direction is restricted to people
         // who may actually moderate, so a rider can't decrement the counter
         // without deleting anything.
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['postCount']) &&
          (request.resource.data.postCount == resource.data.postCount + 1 ||
           (request.resource.data.postCount == resource.data.postCount - 1 &&
            (isAdmin() ||
             resource.data.get('createdBy', '') == request.auth.uid ||
             request.auth.uid in resource.data.get('maintainerIds', []))))) ||
         // ...or the creator/admin edits the maintainer list. Deliberately
         // narrower than moderation: a maintainer can delete posts but must
         // not be able to appoint peers or remove the creator who appointed
         // them (mirrors canManageMaintainers in forum_permissions.dart).
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['maintainerIds']) &&
          (isAdmin() || resource.data.get('createdBy', '') == request.auth.uid)));

      match /posts/{postId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid &&
          request.resource.data.replyCount == 0 &&
          request.resource.data.upvotes == 0 && request.resource.data.downvotes == 0;
        // Three disjoint shapes: addReply's replyCount +1 bump, now tied to
        // the reply doc named by `lastReplyId` being created in the same
        // transaction (docs/Issues.md §24.7 — addReply() was made
        // transactional to allow this, mirroring addComment() on rides); a
        // deleteReply -1; or a votePost bounded upvotes/downvotes change tied
        // to the caller's own votes/{uid} doc via voteBumpValid (same fix and
        // same reasoning as the rides/{rideId} vote clause above; votePost()
        // runs in exactly the same kind of transaction
        // RideShareRepository.vote() does).
        allow update: if request.auth != null &&
          ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount', 'lastReplyId']) &&
            request.resource.data.replyCount == resource.data.replyCount + 1 &&
            request.resource.data.get('lastReplyId', '') is string &&
            request.resource.data.get('lastReplyId', '') != '' &&
            newDocBy(
              /databases/$(database)/documents/forums/$(forumId)/posts/$(postId)/replies/$(request.resource.data.lastReplyId),
              request.auth.uid)) ||
           // -1 via deleteReply, tied to the reply doc named by `lastReplyId`
           // actually being deleted in the same batch. Who is allowed to
           // delete it is settled by the reply's own delete rule below
           // (author or moderator), which runs in that same batch — so if
           // that denies, the whole batch fails and this counter never moves.
           //
           // This used to read `resource.data.userId == request.auth.uid ||
           // canModerateForum(forumId)`, which was wrong: `resource` here is
           // the POST, so it checked the POST's author, not the reply's. A
           // rider deleting their own reply on someone else's post had the
           // whole batch denied (docs/Issues.md §24.11).
           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount', 'lastReplyId']) &&
            request.resource.data.replyCount == resource.data.replyCount - 1 &&
            request.resource.data.get('lastReplyId', '') is string &&
            request.resource.data.get('lastReplyId', '') != '' &&
            docRemoved(
              /databases/$(database)/documents/forums/$(forumId)/posts/$(postId)/replies/$(request.resource.data.lastReplyId))) ||
           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'downvotes']) &&
            voteBumpValid(
              /databases/$(database)/documents/forums/$(forumId)/posts/$(postId)/votes/$(request.auth.uid),
              resource.data.upvotes, request.resource.data.upvotes,
              resource.data.downvotes, request.resource.data.downvotes)));

        // A rider may always remove their own post; removing someone else's
        // requires admin/creator/maintainer. The client shows the trash icon
        // on the same condition, but this is the check that actually binds.
        // Note the post's replies/votes subcollections are NOT reachable from
        // a parent delete — they're left orphaned on purpose for beta (a
        // Cloud Function should reap them); orphans are unreadable in
        // practice since every read path starts from the parent post.
        allow delete: if request.auth != null &&
          (resource.data.userId == request.auth.uid || canModerateForum(forumId));

        // One vote doc per user: { value: 1 | -1 }. No rideVisibleTo-style
        // gate needed — forum posts have no audience tiers, they're readable
        // by any authed rider same as the post itself.
        match /votes/{userId} {
          allow read: if request.auth != null;
          allow write: if request.auth != null && request.auth.uid == userId &&
            (request.method == 'delete' ||
             request.resource.data.value == 1 || request.resource.data.value == -1);
        }

        match /replies/{replyId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
          // Same ownership-or-moderator shape as the post delete above.
          allow delete: if request.auth != null &&
            (resource.data.userId == request.auth.uid || canModerateForum(forumId));
        }
      }
    }

    // Forum follow/membership docs — id is always `{uid}_{forumId}`, so a
    // user can only ever create/delete their own membership row, never
    // someone else's. Split into create/delete (rather than one `write`)
    // because `request.resource` (and therefore `.data.forumId`) is null on
    // a delete — checking it there would make every unfollow() call fail;
    // `resource.data` (the doc being deleted) is what's available instead.
    match /forum_follows/{followId} {
      // Scoped to the owning user — a follow list is behavioral/interest
      // data the app never intends to expose about other users (mirrors the
      // rides/{rideId}/likes ownership check, not the open-read rules above
      // that only apply where content is meant to be publicly readable).
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        followId == (request.auth.uid + '_' + request.resource.data.forumId);
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Places directory (Phase 4 — nearby garages/fuel pumps/parts shops).
    // Standalone top-level collection: `places/{placeId}`. There is
    // deliberately NO nested `places/{placeId}/reviews` block here — the
    // draft this was adapted from (app/firestore_rules_poi_directory.txt,
    // deleted per docs/Issues.md §33.14: it was inert, unreferenced by
    // firebase.json, and materially weaker than these rules) assumed that
    // shape, but ReviewRepository actually reads/writes a
    // standalone top-level `reviews` collection filtered by `placeId` (see
    // ReviewRepository._collection = 'reviews' and getReviewsForPlace /
    // streamReviewsForPlace), so a nested-reviews rule would just be dead
    // code that never matches any real write.
    //
    // Note on `createdAt`: unlike the draft, we do NOT require
    // `request.resource.data.createdAt == request.time`. PlaceModel/
    // ReviewModel serialize `createdAt` as `Timestamp.fromDate(<client
    // DateTime.now()>)`, not `FieldValue.serverTimestamp()` — the client
    // clock will never exactly equal the server's `request.time`, so that
    // check would reject every legitimate create. (This mirrors why the
    // existing rides/{rideId} and forums/{forumId} create rules above also
    // don't check createdAt.)
    match /places/{placeId} {
      allow read: if request.auth != null;

      // addPlace() always creates a place attributed to its creator, not
      // yet verified, with a fresh (zero) rating aggregate — enforce that
      // shape so a client can't spoof authorship or seed a fake rating
      // history for a brand-new place.
      allow create: if request.auth != null &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.verified == false &&
        request.resource.data.ratingSum == 0 &&
        request.resource.data.ratingCount == 0;

      // No screen built in this phase calls updatePlace() /
      // updateVerification() / deletePlace() on PlaceRepository — they
      // exist on the repository but aren't wired to any UI, so (mirroring
      // the forums/{forumId}/posts/{postId} precedent: "no editPost exists
      // ... so scope the rule to exactly what addReply does") we don't
      // grant a broad owner-edit or admin-verify rule for features that
      // aren't built yet. The only update path this phase's UI actually
      // exercises is PlaceDetailScreen's review-submission flow, which
      // writes a new reviews/{reviewId} doc and then bumps this place's
      // ratingSum/ratingCount (ReviewRepository.addReviewAndUpdatePlaceRating
      // — see that method's doc comment for why those two writes are no
      // longer a single atomic transaction). Since updatePlaceRating() sets
      // *absolute* totals (not a FieldValue.increment), a broad "owner can
      // update ratingSum/ratingCount" rule would let anyone set an
      // arbitrary rating — instead, bound the transition precisely, the
      // same way the rides.likes / forums.followerCount ±1-delta rules
      // above do: ratingCount must move by exactly +1 (one review at a
      // time) and ratingSum may only grow by between 1 and 5 (a single new
      // review's star value).
      //
      // That alone still isn't enough: without more, any authenticated
      // user could call this update directly with no review ever having
      // been written (the fabricated-rating vulnerability this rule used
      // to have). Reviews are keyed deterministically as `{uid}_{placeId}`
      // (see reviews/{reviewId} below) specifically so this rule can
      // require a real, matching review to exist before allowing the bump,
      // and that its star value is exactly what's being added — so this
      // update can never fabricate a rating for a place the caller hasn't
      // actually reviewed, nor apply a delta other than their own review's
      // real star count.
      //
      // Known residual limitation (not fully closed by rules alone): this
      // does NOT stop a user from calling this update multiple times and
      // replaying their *own* single real review's delta repeatedly, since
      // there is deliberately no mutable per-review "already applied"
      // marker here — flipping such a marker would need to happen in the
      // same commit as this write (to stay attacker-proof against a client
      // simply skipping a separate "mark applied" call), which runs into
      // the same get()-visibility-within-a-transaction question flagged on
      // addReviewAndUpdatePlaceRating's doc comment. Fully closing that
      // would need either a live-verified same-transaction get() design or
      // a trusted server-side (Cloud Function) aggregate update — out of
      // scope here. This rule still fully closes the original
      // zero-reviews fabrication case: the bump is impossible without at
      // least one real, matching review, and is bounded to that review's
      // actual star value.
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum', 'ratingCount']) &&
        request.resource.data.ratingCount == resource.data.ratingCount + 1 &&
        request.resource.data.ratingSum >= resource.data.ratingSum + 1 &&
        request.resource.data.ratingSum <= resource.data.ratingSum + 5 &&
        exists(/databases/$(database)/documents/reviews/$(request.auth.uid + '_' + placeId)) &&
        get(/databases/$(database)/documents/reviews/$(request.auth.uid + '_' + placeId)).data.stars
          == request.resource.data.ratingSum - resource.data.ratingSum;
    }

    // Reviews — standalone top-level collection (see note above), one doc
    // per submitted review, referencing its place via `placeId`.
    match /reviews/{reviewId} {
      allow read: if request.auth != null;

      // Review ids are deterministic — `{uid}_{placeId}` — mirroring the
      // forum_follows/{uid}_{forumId} pattern above, rather than a random
      // auto-id. This closes the "duplicate review" gap: a second
      // submission attempt by the same user for the same place targets
      // this SAME document id, and since that doc already exists,
      // Firestore's rules engine evaluates the write as an `update` (not a
      // `create`) — request.method is determined purely by whether the
      // target document already exists, not by which client API was
      // called. There is deliberately no `allow update` for this
      // collection (see comment below), so that second write falls
      // through to the deny-all catch-all and is rejected outright. It
      // also lets the places/{placeId} rating-update rule above key off
      // this exact id via exists()/get() to require a real review backing
      // any rating-aggregate bump.
      //
      // reviewId must match the authenticated user's uid + the place being
      // reviewed — the same way forum_follows's create rule pins followId
      // to `{auth.uid}_{forumId}` so nobody can create a row keyed to
      // someone else's uid. Enforce ownership and a valid 1-5 star value
      // (the UI's star picker only ever offers 1-5, but a rule should not
      // trust the client for that).
      allow create: if request.auth != null &&
        reviewId == (request.auth.uid + '_' + request.resource.data.placeId) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.flagged == false &&
        request.resource.data.stars >= 1 &&
        request.resource.data.stars <= 5;

      // updateReview() / deleteReview() / flagReview() exist on
      // ReviewRepository but — like updatePlace() above — aren't called
      // from any screen built in this phase, so no update/delete rule is
      // granted for them; they fall through to the catch-all deny below
      // until a real edit/moderation UI (and a matching narrowly-scoped
      // rule) is built. This absence is also load-bearing for the
      // deterministic-id create rule above: a second `create` attempt at
      // an existing id has nowhere else to go but that catch-all.
    }

    // Username reservations — `usernames/{handleLower}` → { uid }. Makes
    // @handles globally unique and gives a cheap handle→uid lookup. A rider
    // can only ever claim a free handle for themselves (create requires the
    // doc not exist and uid==self), keep their own (update with uid
    // unchanged), or release their own (delete). There is no way to overwrite
    // someone else's handle.
    //
    // `get`, deliberately NOT `read` — same reasoning as `liveSessions`
    // below (docs/Issues.md §3): `read` = `get` + `list`, and a `list` grant
    // here would let anyone enumerate every handle→uid pair. `allow get: if
    // true` (no auth required) rather than gating on `request.auth != null`
    // because the permanent share link (`/r/{username}`) is resolved by
    // public/live-viewer.html, which never signs in — the whole point of a
    // shareable link is that the person opening it doesn't need the app.
    // Every real caller does a keyed `.doc(handle)` lookup (ProfileRepository,
    // live-viewer.html), so nothing legitimately lists this collection.
    match /usernames/{handle} {
      allow get: if true;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Live pointer — `livePointers/{uid}` → { token, active }. The other half
    // of the permanent share link: resolves a uid to "are they riding right
    // now, and if so which liveSessions/{token}". Deliberately keyed by uid
    // (from the signed-in rider's own auth), not by username — the rule
    // below is then a straight path match with no profile lookup, and it is
    // structurally impossible for one rider to write another's pointer.
    //
    // `get: if true`, not `read`, for the same reason as `usernames` and
    // `liveSessions`: the public viewer page reads this without signing in,
    // and only a keyed lookup is ever done — granting `list` would let a
    // client enumerate every rider's on/off-riding status for free.
    match /livePointers/{uid} {
      allow get: if true;
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.uid == uid;
    }

    // Follow graph — one edge doc per (follower → followee) at
    // `follows/{followerUid}_{followeeUid}`. The composite id pins a rider to
    // only ever creating/deleting edges they originate (mirrors the
    // forum_follows / reviews deterministic-id pattern). Reads are open to
    // authed users so follower/following lists and mutual-friend computation
    // work. Counts are derived via count() aggregation — no counter to spoof.
    match /follows/{edgeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.followerUid == request.auth.uid &&
        edgeId == (request.auth.uid + '_' + request.resource.data.followeeUid);
      allow delete: if request.auth != null && resource.data.followerUid == request.auth.uid;
    }

    // ------------------------------------------------------------------
    // Group rides ("Ride with friends"). Membership is gated on the flat uid
    // arrays memberIds (joined) / invitedIds (invited, not yet joined),
    // because `members` is an array of maps and the rules language cannot
    // project a field out of one — `request.auth.uid in resource.data.members`
    // is inexpressible. GroupRideRepository keeps all three in lockstep.
    // ------------------------------------------------------------------
    match /groupRides/{groupRideId} {
      // Creator, joined members, and riders still holding an open invitation.
      // Invitees need read access BEFORE accepting: tapping the notification
      // reads the ride, accepts, and opens the map in one motion.
      function inGroupRide() {
        return request.auth != null && (
          request.auth.uid == resource.data.creatorId ||
          request.auth.uid in resource.data.get('memberIds', []) ||
          request.auth.uid in resource.data.get('invitedIds', []));
      }

      // Also readable by `get` (never `list`, so nobody can enumerate rides)
      // to any signed-in rider once the ride is active — the same
      // unguessable-token trust model as the /live/{token} and /r/{username}
      // live-share links elsewhere in this file: the only way to learn a
      // specific groupRideId without already being on the ride is resolving
      // a shared join code through groupRideJoinCodes below, and that code is
      // exactly as hard to guess as those tokens. This is what lets the
      // "confirm join" screen preview a ride (name, creator, headcount)
      // before the rider commits.
      allow get: if inGroupRide() ||
        (request.auth != null && resource.data.status == 'active');

      // `list` is granted ONLY in the shape getUserGroupRides queries — a
      // list rule must be provable from the query's own filters.
      // getUpcomingGroupRides (status + startTime) is deliberately NOT
      // satisfiable: no screen calls it, and opening it would expose every
      // rider's group rides.
      allow list: if request.auth != null &&
        resource.data.creatorId == request.auth.uid;

      // A ride is always created by its creator with themselves as the only
      // joined member — nobody conjures a ride they aren't on, or seeds one
      // pre-populated with members who never agreed.
      // The roster lives in the members subcollection below, never inline on
      // this document — refusing a `members` key here makes that invariant
      // unforgeable rather than merely conventional. Only affects NEW rides;
      // pre-existing rides keep their legacy inline array and still read.
      allow create: if request.auth != null &&
        request.resource.data.creatorId == request.auth.uid &&
        request.resource.data.memberIds == [request.auth.uid] &&
        !('members' in request.resource.data);

      allow update: if request.auth != null && (
        // 1. The creator: status changes, removing a member, ending the ride.
        //    May never reassign authorship.
        (resource.data.creatorId == request.auth.uid &&
         request.resource.data.creatorId == resource.data.creatorId) ||

        // 2. An invited rider accepting or declining. The roster is no longer
        //    here — it lives in the members subcollection below, where a
        //    rider can only write their own document — so this clause has
        //    nothing left to bound but the two flat uid arrays: add exactly
        //    themselves to memberIds, remove exactly themselves from
        //    invitedIds.
        //
        //    docs/Issues.md §24.6: invitedIds' new value must be EXACTLY the
        //    old list with the caller removed — not just "caller isn't in
        //    it anymore". The previous `!(auth.uid in new invitedIds)` check
        //    bounded only whether the caller stayed out, not what else
        //    changed in the same write, so an accepting invitee could
        //    rewrite invitedIds to any list of uids they liked (adding
        //    strangers, who'd then satisfy inGroupRide() and gain read on
        //    memberLocations/{uid} — every member's live position — or
        //    deleting other pending invitees). Same bug class as §10, which
        //    fixed the equivalent hole in memberIds by moving the roster to
        //    documents; it survived here because §10 never touched the
        //    invite array.
        (request.auth.uid in resource.data.get('invitedIds', []) &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['memberIds', 'invitedIds']) &&
         // new invitedIds ⊆ old invitedIds (nobody added)...
         !(request.auth.uid in request.resource.data.get('invitedIds', [])) &&
         request.resource.data.get('invitedIds', [])
           .hasOnly(resource.data.get('invitedIds', [])) &&
         // ...and old invitedIds ⊆ new invitedIds + {caller} (nobody else
         // removed) — together these two hasOnly checks (same set-equality
         // idiom the memberIds lines below already use) pin the new value to
         // EXACTLY the old list minus the caller, not merely "doesn't
         // contain the caller anymore".
         resource.data.get('invitedIds', [])
           .hasOnly(request.resource.data.get('invitedIds', []).concat([request.auth.uid])) &&
         request.resource.data.get('memberIds', [])
           .hasAll(resource.data.get('memberIds', [])) &&
         request.resource.data.get('memberIds', [])
           .hasOnly(resource.data.get('memberIds', []).concat([request.auth.uid]))) ||

        // 3. A joined rider leaving. Removes exactly themselves. The creator
        //    can't take this path — leaveGroupRide ends the ride for them
        //    instead (clause 1), so a ride is never orphaned.
        (request.auth.uid in resource.data.get('memberIds', []) &&
         request.auth.uid != resource.data.creatorId &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['memberIds']) &&
         !(request.auth.uid in request.resource.data.get('memberIds', [])) &&
         resource.data.get('memberIds', [])
           .hasAll(request.resource.data.get('memberIds', []))) ||

        // 4. A stranger joining via a shared join code (groupRideJoinCodes
        //    below) rather than an invite — GroupRideRepository.joinByCode.
        //    Adds exactly themselves to memberIds on a ride that's ACTIVE and
        //    not already at its cap. There is no Cloud Function to check GPS
        //    proximity server-side (Blaze-gated, see HANDOFF_Document.md), so
        //    "nearby" is a client-side courtesy prompt only — the actual
        //    security boundary is the same unguessable-code model as the
        //    `allow get` carve-out above, not a location check.
        (resource.data.status == 'active' &&
         !(request.auth.uid in resource.data.get('memberIds', [])) &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['memberIds']) &&
         request.auth.uid in request.resource.data.get('memberIds', []) &&
         request.resource.data.get('memberIds', [])
           .hasOnly(resource.data.get('memberIds', []).concat([request.auth.uid])) &&
         request.resource.data.get('memberIds', [])
           .hasAll(resource.data.get('memberIds', [])) &&
         request.resource.data.get('memberIds', []).size() <=
           resource.data.get('maxParticipants', 20)));

      allow delete: if request.auth != null &&
        resource.data.creatorId == request.auth.uid;

      // Roster documents, one per rider at `members/{uid}`.
      //
      // The roster used to be an array of maps on the ride document itself.
      // Rules cannot project a field out of an array of maps, so the accept
      // clause above could only bound the array's *size* — an invited rider
      // accepting was free to rewrite every other member's display name in
      // the same write. As documents the rule is exactly expressible, in the
      // same shape memberLocations/{uid} already uses: the {uid} wildcard is
      // pinned to request.auth.uid on write.
      //
      // The creator is the exception, and has to be: creating a ride seeds a
      // `pending` document (carrying a name) for every invitee, and kicking
      // somebody deletes theirs. That is no new power — the creator can
      // already end or delete the whole ride.
      match /members/{memberUid} {
        function ride() {
          return get(/databases/$(database)/documents/groupRides/$(groupRideId)).data;
        }
        allow read: if request.auth != null && (
          request.auth.uid == ride().creatorId ||
          request.auth.uid in ride().get('memberIds', []) ||
          request.auth.uid in ride().get('invitedIds', []));
        allow write: if request.auth != null && (
          request.auth.uid == ride().creatorId ||
          // Anyone else writes ONLY their own entry, and only while on the
          // ride or holding an open invitation. An accepting invitee is still
          // in invitedIds at the instant they write: rules evaluate against
          // the committed document, not the pending transaction.
          (request.auth.uid == memberUid && (
            request.auth.uid in ride().get('memberIds', []) ||
            request.auth.uid in ride().get('invitedIds', []) ||
            // Joining via code (joinByCode): the sibling write to memberIds
            // on the parent (clause 4 above) is validated independently and
            // hasn't committed yet when this rule evaluates `ride()`, so it
            // can only check that the ride is live, not that the caller is
            // already listed. Accepted, narrow tradeoff: a signed-in rider
            // who knows an active ride's id could plant their own `pending`-
            // looking roster row here without also being added to
            // memberIds — cosmetic only, since every real privilege
            // (locations, voice notes) is gated on memberIds/invitedIds on
            // the parent, never on this subcollection's mere existence.
            ride().status == 'active')));
      }

      // Invitation markers, one per invited rider at `invitations/{uid}`.
      // Only the ride's creator hands them out; the invitee or the creator
      // clears them.
      match /invitations/{invitedUid} {
        function rideCreator() {
          return get(/databases/$(database)/documents/groupRides/$(groupRideId)).data.creatorId;
        }
        allow read: if request.auth != null &&
          (request.auth.uid == invitedUid || request.auth.uid == rideCreator());
        allow create, update: if request.auth != null &&
          request.auth.uid == rideCreator();
        allow delete: if request.auth != null &&
          (request.auth.uid == invitedUid || request.auth.uid == rideCreator());
      }

      // Push-to-talk voice notes, one document per clip at
      // `voiceNotes/{noteId}`. Create+read only — there is no update/delete
      // path, so a sent clip can never be edited or retracted, and the
      // create clause is the entire security surface for this collection.
      //
      // Only a JOINED member may send (not merely an invited one — an
      // invitee can read the ride and its roster before accepting, but may
      // not talk into it), senderId is pinned to the caller so nobody can
      // send as somebody else, every field is whitelisted with hasOnly() so
      // no other data rides along in the same write, audioUrl is pinned to
      // Cloudinary's own host so this collection can't be used to broadcast
      // arbitrary links, and createdAt must be exactly request.time — the
      // same idiom the rest of this file uses to force
      // FieldValue.serverTimestamp() rather than a spoofable client clock.
      match /voiceNotes/{noteId} {
        function ride() {
          return get(/databases/$(database)/documents/groupRides/$(groupRideId)).data;
        }
        allow read: if request.auth != null && (
          request.auth.uid == ride().creatorId ||
          request.auth.uid in ride().get('memberIds', []) ||
          request.auth.uid in ride().get('invitedIds', []));

        allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.senderId &&
          (request.auth.uid == ride().creatorId ||
           request.auth.uid in ride().get('memberIds', [])) &&
          request.resource.data.keys().hasOnly([
            'senderId', 'senderName', 'senderPhotoUrl', 'audioUrl',
            'durationMs', 'createdAt'
          ]) &&
          request.resource.data.senderId is string &&
          request.resource.data.senderName is string &&
          request.resource.data.audioUrl is string &&
          request.resource.data.audioUrl.matches('https://res[.]cloudinary[.]com/.*') &&
          request.resource.data.durationMs is int &&
          request.resource.data.durationMs >= 800 &&
          request.resource.data.durationMs <= 60000 &&
          request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }

      // Live positions, one document per rider at `memberLocations/{uid}`.
      // The {uid} wildcard is pinned to request.auth.uid on write, so a rider
      // can only ever move their OWN marker, and only while actually on the
      // ride. Members and pending invitees may read all of them (an invitee
      // reads so the map has something to show the instant they tap through).
      match /memberLocations/{riderUid} {
        function ride() {
          return get(/databases/$(database)/documents/groupRides/$(groupRideId)).data;
        }
        allow read: if request.auth != null && (
          request.auth.uid == ride().creatorId ||
          request.auth.uid in ride().get('memberIds', []) ||
          request.auth.uid in ride().get('invitedIds', []));
        allow write: if request.auth != null &&
          request.auth.uid == riderUid && (
            request.auth.uid == ride().creatorId ||
            request.auth.uid in ride().get('memberIds', []));
      }
    }

    // Join-code → groupRideId lookup for the code-based "door in" on an
    // active group ride (GroupRideRepository.joinByCode). One document per
    // code at the top level (not nested under groupRides, since the whole
    // point is resolving this BEFORE the caller has any relationship to the
    // ride the code points at).
    //
    // `get` is safe on a code the caller already typed in — same
    // unguessable-bearer-token model as the groupRides `allow get` carve-out
    // above — but `list` stays closed so nobody can enumerate every ride's
    // code by scanning this collection.
    match /groupRideJoinCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      // Written once, by createGroupRide, in the same batch as the ride
      // itself; never changes afterward. Not tied to the ride's creatorId
      // here — the ride document doesn't exist yet elsewhere in the same
      // batch for a rule's `get()` to check against — so this only pins the
      // shape, not the linkage. Low-severity accepted gap: a signed-in rider
      // could squat an unused code with a bogus groupRideId, which at worst
      // makes joinByCode resolve to "no such ride" for whoever tries that
      // exact code next — it grants no read/write access to anything real.
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['groupRideId', 'createdAt']) &&
        request.resource.data.groupRideId is string &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // roadSpeedSamples/{segmentId}/samples/{sampleId} — anonymous speed
    // samples pooled per road-segment proxy (a geohash cell, not a real
    // road — see `app/lib/features/ride/domain/calculators/
    // segment_speed_aggregator.dart`), so a rider's own ride summary can
    // compare their speed on a stretch against everyone else's historical
    // speed there. A sample deliberately carries no uid, no rideId, and no
    // exact lat/lng — only the coarse geohash cell (the collection key
    // itself, ~150m at precision 7) and the sample's speed/weekday/hour/
    // weather. It's an anonymous contribution to a shared pool, not owned by
    // anyone, so there is no per-doc owner check — only a tight shape check,
    // mirroring groupRides/voiceNotes' bounded create-only pattern above.
    match /roadSpeedSamples/{segmentId} {
      match /samples/{sampleId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null &&
          request.resource.data.keys().hasOnly([
            'speedKmh', 'weekday', 'hour', 'weatherCode', 'createdAt'
          ]) &&
          request.resource.data.speedKmh is number &&
          request.resource.data.speedKmh >= 0 &&
          request.resource.data.speedKmh <= 400 &&
          request.resource.data.weekday is int &&
          request.resource.data.weekday >= 1 && request.resource.data.weekday <= 7 &&
          request.resource.data.hour is int &&
          request.resource.data.hour >= 0 && request.resource.data.hour <= 23 &&
          (request.resource.data.weatherCode == null ||
            request.resource.data.weatherCode is int) &&
          request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
